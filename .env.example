# Copy to .env and fill in. Never commit real values. Full reference: docs/env.md
# Used by: W = apps/web (server), K = apps/worker

# --- Supabase (hosted) ---------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project.supabase.co        # W (browser-safe)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key                       # W (browser-safe, RLS applies)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key              # W K (bypasses RLS; server only)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres  # K (queue claims)

# --- Cloudflare R2 -------------------------------------------------------------
R2_ACCOUNT_ID=your-account-id                                # W K
R2_ACCESS_KEY_ID=your-access-key-id                          # W K
R2_SECRET_ACCESS_KEY=your-secret-access-key                  # W K
R2_BUCKET=clip-studio                                        # W K

# --- Encryption ----------------------------------------------------------------
# 32 random bytes, base64. `openssl rand -base64 32`. Encrypts BYOK keys + OAuth refresh tokens.
APP_ENCRYPTION_KEY=base64-32-bytes                           # W K

# --- Google OAuth: YouTube connect (separate from Supabase Google login) -------
# Login uses Supabase's Google provider, configured in the Supabase dashboard, not here.
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com  # W K
YOUTUBE_CLIENT_SECRET=your-client-secret                     # W K
YOUTUBE_REDIRECT_URI=http://localhost:5173/settings/youtube/callback  # W

# User-supplied keys (Anthropic, Deepgram/AssemblyAI/Groq, Wispr) are BYOK:
# stored encrypted per user in user_keys, never in env.
