{
	"permissions": {
		"allow": [
			"Bash(pnpm *)",
			"Bash(uv *)",
			"Bash(docker compose *)",
			"Bash(npx supabase migration new *)",
			"Bash(npx supabase gen types *)",
			"Bash(node scripts/check-docs.ts *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git worktree *)",
			"Bash(ffmpeg *)",
			"Bash(ffprobe *)",
			"Bash(psql *)",
			"Bash(gitleaks *)"
		],
		"deny": [
			"Bash(npx supabase db push *)",
			"Bash(npx supabase link *)",
			"Bash(pnpm dlx *)",
			"Bash(git push *)",
			"Bash(git reset --hard *)",
			"Bash(git clean *)",
			"Bash(rm /*)",
			"Bash(rm * /*)",
			"Bash(rm *~*)",
			"Bash(rm *../*)"
		]
	},
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-docs.ts\" --hook",
						"timeout": 30
					}
				]
			}
		]
	}
}
