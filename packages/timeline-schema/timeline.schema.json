{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://clip-studio.local/timeline.schema.json",
	"title": "Timeline",
	"description": "Single source of truth for a clip edit. Mirrors: src/index.ts (zod), apps/worker/worker/timeline.py (pydantic). Docs: docs/timeline.md",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"version",
		"sourceKey",
		"aspect",
		"cropX",
		"segments",
		"originalAudio",
		"audio",
		"ducking",
		"captions",
		"textOverlays",
		"blurRegions"
	],
	"properties": {
		"version": { "const": 2 },
		"sourceKey": { "type": "string", "minLength": 1, "description": "R2 key of the clip file (cut with 5s handles); segments without their own sourceKey use it" },
		"aspect": { "enum": ["9:16", "1:1", "16:9"] },
		"cropX": { "type": "number", "minimum": 0, "maximum": 1, "description": "Horizontal crop position when the source is wider than the aspect: 0 left, 0.5 centre, 1 right" },
		"segments": {
			"description": "Kept ranges of a source file, in output order (seconds of that file)",
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["start", "end"],
				"properties": {
					"start": { "type": "number", "minimum": 0 },
					"end": { "type": "number", "minimum": 0 },
					"sourceKey": { "type": "string", "minLength": 1, "description": "Another clip file or an uploaded video (merge); default: the timeline's sourceKey" }
				}
			}
		},
		"originalAudio": {
			"type": "object",
			"additionalProperties": false,
			"required": ["muted", "volume"],
			"properties": {
				"muted": { "type": "boolean" },
				"volume": { "$ref": "#/$defs/volume" }
			}
		},
		"audio": {
			"description": "Added audio tracks; start is on the OUTPUT timeline",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "kind", "key", "start", "volume", "muted"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"kind": { "enum": ["voiceover", "music"] },
					"key": { "type": "string", "minLength": 1 },
					"start": { "type": "number", "minimum": 0 },
					"volume": { "$ref": "#/$defs/volume" },
					"muted": { "type": "boolean" }
				}
			}
		},
		"ducking": { "type": "boolean", "description": "Lower music while the original audio or a voiceover plays" },
		"captions": {
			"description": "Burned-in captions; text comes from clips.words mapped through segments",
			"type": "object",
			"additionalProperties": false,
			"required": ["enabled", "style"],
			"properties": {
				"enabled": { "type": "boolean" },
				"style": {
					"type": "object",
					"additionalProperties": false,
					"required": ["font", "color", "position", "size", "wordsPerChunk"],
					"properties": {
						"font": { "type": "string", "minLength": 1 },
						"color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
						"position": { "$ref": "#/$defs/position" },
						"size": { "enum": ["small", "medium", "large"] },
						"wordsPerChunk": { "type": "integer", "minimum": 1, "maximum": 5 }
					}
				}
			}
		},
		"textOverlays": {
			"description": "Times are on the OUTPUT timeline (seconds)",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["start", "end", "text", "position"],
				"properties": {
					"start": { "type": "number", "minimum": 0 },
					"end": { "type": "number", "minimum": 0 },
					"text": { "type": "string", "minLength": 1 },
					"position": { "$ref": "#/$defs/position" }
				}
			}
		},
		"blurRegions": {
			"description": "Times on the OUTPUT timeline; x, y, w, h are fractions (0..1) of the output frame",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["start", "end", "x", "y", "w", "h"],
				"properties": {
					"start": { "type": "number", "minimum": 0 },
					"end": { "type": "number", "minimum": 0 },
					"x": { "$ref": "#/$defs/fraction" },
					"y": { "$ref": "#/$defs/fraction" },
					"w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
					"h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
				}
			}
		}
	},
	"$defs": {
		"volume": { "type": "number", "minimum": 0, "maximum": 2 },
		"fraction": { "type": "number", "minimum": 0, "maximum": 1 },
		"position": { "enum": ["top", "center", "bottom"] }
	}
}
