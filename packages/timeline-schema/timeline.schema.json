{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://clip-studio.local/timeline.schema.json",
	"title": "Timeline",
	"description": "Single source of truth for a clip edit. Mirrors: src/index.ts (zod), apps/worker/worker/timeline.py (pydantic). Docs: docs/timeline.md",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "sourceKey", "aspect", "segments", "captions", "textOverlays"],
	"properties": {
		"version": { "const": 1 },
		"sourceKey": { "type": "string", "minLength": 1, "description": "R2 object key of the source video" },
		"aspect": { "enum": ["9:16", "1:1", "16:9"] },
		"segments": {
			"description": "Kept ranges of the source, in output order (seconds)",
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/range" }
		},
		"captions": {
			"description": "Times are on the OUTPUT timeline (seconds)",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["start", "end", "text"],
				"properties": {
					"start": { "type": "number", "minimum": 0 },
					"end": { "type": "number", "minimum": 0 },
					"text": { "type": "string", "minLength": 1 }
				}
			}
		},
		"textOverlays": {
			"description": "Times are on the OUTPUT timeline (seconds)",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["start", "end", "text", "position"],
				"properties": {
					"start": { "type": "number", "minimum": 0 },
					"end": { "type": "number", "minimum": 0 },
					"text": { "type": "string", "minLength": 1 },
					"position": { "enum": ["top", "center", "bottom"] }
				}
			}
		}
	},
	"$defs": {
		"range": {
			"type": "object",
			"additionalProperties": false,
			"required": ["start", "end"],
			"properties": {
				"start": { "type": "number", "minimum": 0 },
				"end": { "type": "number", "minimum": 0 }
			}
		}
	}
}
