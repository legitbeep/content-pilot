# Copy to apps/worker/.env and fill in. Never commit real values. Reference: docs/env.md
# docker-compose.yml loads this file into the worker container.

# --- Supabase ------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Encryption ----------------------------------------------------------------
ENCRYPTION_KEY=base64-32-bytes                            # same value as apps/web/.env

# --- Cloudflare R2 -------------------------------------------------------------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=clip-studio

# --- YouTube (token refresh, uploads, stats) -----------------------------------
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# --- Demo allowlist (ADR 0008, docs/llm.md) -------------------------------------
# Users' AI keys are BYOK (Settings). These shared keys are used ONLY for verified emails listed
# here, when that user has no key of their own. Same values as apps/web/.env. Leave empty to disable.
DEMO_ALLOWED_EMAILS=demo@example.com
DEMO_DAILY_JOB_LIMIT=10
GEMINI_API_KEY=your-gemini-key                            # demo LLM key
GROQ_API_KEY=gsk_xxx                                      # demo transcription key
