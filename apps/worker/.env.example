# Copy to apps/worker/.env and fill in. Never commit real values. Reference: docs/env.md
# docker-compose.yml loads this file into the worker container.

# --- Supabase ------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres:%40Deadproject08@db.kelazqlcswrwnsctqjub.supabase.co:5432/postgres

# --- Encryption ----------------------------------------------------------------
ENCRYPTION_KEY=base64-32-bytes                            # same value as apps/web/.env

# --- Claude (AI pipeline steps; server-wide, not BYOK — ADR 0007) -------------
CLAUDE_OAUTH_TOKEN=sk-ant-oat01-xxx                       # from `claude setup-token`; same value as apps/web/.env

# --- Cloudflare R2 -------------------------------------------------------------
