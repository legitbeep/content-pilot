# Copy to apps/web/.env and fill in. Never commit real values. Reference: docs/env.md
# On Vercel, set these in the project's environment variables instead.

# --- Supabase ------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx        # browser-safe, RLS applies
SUPABASE_SECRET_KEY=sb_secret_xxx                         # server only, never imported in client code

# --- Encryption ----------------------------------------------------------------
# base64, 32 bytes: `openssl rand -base64 32`. Same value as apps/worker/.env.
ENCRYPTION_KEY=base64-32-bytes

# --- Claude (all AI steps; server-wide, not BYOK — ADR 0007) -------------------
# From `claude setup-token`. Server only, never imported in client code.
CLAUDE_OAUTH_TOKEN=sk-ant-oat01-xxx

# --- Cloudflare R2 (presigned browser uploads) ---------------------------------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=clip-studio

# --- YouTube connect (separate from Supabase Google login) ---------------------
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:5173/settings/youtube/callback

# --- Dev login (only under `pnpm dev`; ignored in production builds) -----------
# true enables GET/POST /auth/dev-login: signs in a test user without Google. docs/auth-and-keys.md
DEV_LOGIN=false
DEV_LOGIN_EMAIL=dev@clip-studio.test
DEV_LOGIN_PASSWORD=change-me-dev-password

# User API keys (Deepgram/AssemblyAI/Groq, Wispr) are BYOK, stored encrypted
# per user in user_keys, never in env.
